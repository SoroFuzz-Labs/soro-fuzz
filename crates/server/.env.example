DATABASE_URL=postgres://soro_fuzz:soro_fuzz@localhost:5432/soro_fuzz
HTTP_ADDR=0.0.0.0:8080
TARGETS_DIR=../../examples
DEFAULT_BUDGET_SECONDS=60
MAX_CONCURRENT_CAMPAIGNS=2
RUST_TOOLCHAIN=nightly
FUZZ_SANITIZER=
FUZZ_SANDBOX=local
# Defaults to {TARGETS_DIR}/../fuzz if unset — override when the sandbox
# sees the fuzz workspace at a different path than the host does (e.g. a
# docker-exec sandbox's mount point).
# FUZZ_WORKSPACE_DIR=../../fuzz
JOB_TIMEOUT_SECONDS=600
LOG_LEVEL=info
